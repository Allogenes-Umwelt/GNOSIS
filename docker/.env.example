# GNOSIS — variables de entorno. Copia este archivo a .env y complétalo:
#   cp .env.example .env
# El .env real está gitignoreado y NO entra a la imagen (.containerignore).

# ── LLM (Gnosis·IA) ──────────────────────────────────────────────────
# Proveedor por defecto. Sin esta llave el chat no funciona (el resto de
# la app sí). Consíguela en https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Proveedor de respaldo, activable en el panel de admin. Opcional.
ANTHROPIC_API_KEY=

# ── Sesión ───────────────────────────────────────────────────────────
# Firma las cookies de sesión. Genera una fuerte con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si la dejas vacía, GNOSIS usa una efímera (las sesiones se reinician al
# reiniciar el contenedor).
FLASK_SECRET_KEY=

# ── Candado de operador ──────────────────────────────────────────────
# Si lo defines, exigen el header X-Gnosis-Token con este valor:
#   · TODA petición mutante (POST/PUT/DELETE/PATCH), y
#   · las LECTURAS sensibles: /download/*, /ticket/*, /errores/download,
#     /admin/* y /api/v1/admin/*.
#
# PONLO. El contenedor escucha en 0.0.0.0:5001, así que cualquier equipo de
# la red puede pedir `/download/ZipGeneral.zip` — el concentrado aduanal
# completo del mes, con VIN, facturas y precios. Vacío solo tiene sentido si
# el puerto no sale de tu máquina (compose con `127.0.0.1:5001:5001`).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GNOSIS_TOKEN=
